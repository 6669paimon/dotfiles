#open files in maximized window
# set window-height 3000
# set window-width 3000

# Open document in fit-width mode by default
set adjust-open "best-fit"
#set adjust-open "width"

# One page per row by default
set pages-per-row 1

set font "CaskaydiaCove Nerd Font 12"

# copy selection to system clipboard
set selection-clipboard clipboard 

map <C-b> toggle_statusbar

#stop at page boundries
set scroll-page-aware "true"
set smooth-scroll "true"
set scroll-full-overlap 0.01
set scroll-step 100


set recolor "true"
set recolor-reverse-video "true"
set recolor-keephue "true"
#set render-loading "false"


#=============================#
#       Dark blue theme       #
#=============================#
set default-bg "#010a10"
set default-fg "#C9D1D9"
set recolor-lightcolor "#03121c"
set recolor-darkcolor "#C9D1D9"

set highlight-color "#3B6E8F80"          # ผลค้นหา
set highlight-active-color "#E3B34180"   # ผลค้นหาที่เลือกอยู่

# ---------- Notification ----------
set notification-bg          "#0b1e2b"
set notification-fg          "#C9D1D9"
set notification-error-bg    "#3a1418"
set notification-error-fg    "#ff8b8b"
set notification-warning-bg  "#3a2e12"
set notification-warning-fg  "#E3B341"

# ---------- Completion (เมนูเติมคำเวลาพิมพ์ :) ----------
set completion-bg            "#0b1e2b"
set completion-fg            "#C9D1D9"
set completion-group-bg      "#08171f"
set completion-group-fg      "#6CB6D9"
set completion-highlight-bg  "#3B6E8F"
set completion-highlight-fg  "#ffffff"

# ---------- Statusbar / Inputbar ----------
set statusbar-bg             "#0b1e2b"
set statusbar-fg             "#9AA7B4"
set inputbar-bg              "#0b1e2b"
set inputbar-fg              "#C9D1D9"

# ---------- Index (สารบัญ กด Tab) ----------
set index-bg                 "#03121c"
set index-fg                 "#C9D1D9"
set index-active-bg          "#3B6E8F"
set index-active-fg          "#ffffff"

# ---------- Loading ----------
set render-loading-bg        "#03121c"
set render-loading-fg        "#9AA7B4"



